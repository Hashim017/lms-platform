@model QuizResultViewModel
@{
    ViewData["Title"] = "Quiz result";
}

<div class="glass p-4 p-md-5 text-center mb-4 reveal">
    <div class="d-inline-block" style="--size:150px"><partial name="_Ring" model="Model.Percent" /></div>
    <h2 class="mt-3">@(Model.Passed ? "You passed!" : "Not this time")</h2>
    <p class="text-muted">You got @Model.Score of @Model.Total right. The pass mark is @Model.Quiz.PassMark%.</p>
    <div class="d-flex justify-content-center gap-2 flex-wrap">
        <a class="btn btn-primary" asp-action="Take" asp-route-id="@Model.Quiz.Id"><i class="bi bi-arrow-repeat"></i> Try again</a>
        <a class="btn btn-ghost" asp-controller="Courses" asp-action="Details" asp-route-id="@Model.Course.Id">Back to course</a>
    </div>
</div>

<h4 class="mb-3">Review</h4>

@for (var i = 0; i < Model.Items.Count; i++)
{
    var item = Model.Items[i];
<div class="glass p-4 mb-3 reveal">
    <div class="small text-muted mb-1">Question @(i + 1)</div>
    <h5 class="mb-3">@item.Question</h5>
    @foreach (var o in item.Options)
        {
            var isRight = o.Id == item.CorrectId;
            var isWrong = o.Id == item.SelectedId && !isRight;
            var cls = isRight ? "right" : isWrong ? "wrong" : "";
            var icon = isRight ? "bi-check-circle-fill text-success" : isWrong ? "bi-x-circle-fill" : "bi-circle";
    <div class="qopt review @cls">
        <i class="bi @icon"></i>
        <span>@o.Text</span>
    </div>
        }
    @if (item.SelectedId == 0)
        {
    <div class="small text-muted">You skipped this question.</div>
        }
</div>
}

@section Scripts {
    @if (Model.Passed)
    {
    <script>setTimeout(function () { launchConfetti(); }, 300);</script>
    }
}