@model CourseFormViewModel
@{
    ViewData["Title"] = "New course";
}

<h1>New course</h1>

<form asp-action="Create" method="post">
    <partial name="_CourseForm" model="Model" />
    <button class="btn btn-primary">Save</button>
    <a class="btn btn-secondary" asp-action="Manage">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}