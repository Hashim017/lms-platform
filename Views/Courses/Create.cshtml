@model CourseFormViewModel
@{
    ViewData["Title"] = "New course";
}

<div class="glass form-card reveal">
    <h2 class="mb-4">New <span class="grad-text">course</span></h2>
    <form asp-action="Create" method="post">
        <partial name="_CourseForm" model="Model" />
        <button class="btn btn-primary">Save course</button>
        <a class="btn btn-ghost" asp-action="Manage">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}