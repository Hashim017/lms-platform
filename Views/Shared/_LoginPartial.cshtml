@if (User.Identity?.IsAuthenticated == true)
{
    var name = User.Identity?.Name ?? "?";
<div class="dropdown">
    <button class="avatar" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu">
        @name.Substring(0, 1).ToUpper()
    </button>
    <ul class="dropdown-menu dropdown-menu-end">
        <li class="px-3 py-2 small text-muted">@name</li>
        <li><hr class="dropdown-divider" /></li>
        <li><a class="dropdown-item" asp-controller="Enrollments" asp-action="MyLearning"><i class="bi bi-journal-bookmark me-2"></i>My learning</a></li>
        <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index"><i class="bi bi-person-gear me-2"></i>Account</a></li>
        <li>
            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Content("~/")" method="post">
                <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
            </form>
        </li>
    </ul>
</div>
}
else
{
<a class="btn btn-ghost btn-sm" asp-area="Identity" asp-page="/Account/Login">Login</a>
<a class="btn btn-primary btn-sm" asp-area="Identity" asp-page="/Account/Register">Sign up</a>
}