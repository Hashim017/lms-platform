@model Course
@{
    ViewData["Title"] = Model.Title;
    var canManage = (bool)(ViewBag.CanManage ?? false);
}

@if (TempData["Success"] != null)
{
<div class="alert alert-success">@TempData["Success"]</div>
}

<div class="mb-4">
    <h1>@Model.Title</h1>
    <p class="text-muted">@Model.Category | @Model.Level | By @Model.Instructor?.FullName</p>
    @if (!Model.IsPublished)
    {
    <span class="badge bg-warning text-dark">Draft</span>
    }
    <p class="mt-3">@Model.Description</p>
</div>

@if (canManage)
{
<div class="mb-4 d-flex gap-2">
    <a class="btn btn-primary" asp-controller="Lessons" asp-action="Create" asp-route-courseId="@Model.Id">Add lesson</a>
    <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit course</a>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Delete this course?');">
        <button class="btn btn-outline-danger">Delete course</button>
    </form>
</div>
}

<h3>Lessons</h3>

@if (!Model.Lessons.Any())
{
<p class="text-muted">No lessons yet.</p>
}
else
{
<ul class="list-group">
    @foreach (var l in Model.Lessons.OrderBy(x => x.Order))
        {
    <li class="list-group-item d-flex justify-content-between align-items-center">
        <span>@(l.Order). @l.Title</span>
        @if (canManage)
                {
        <span class="d-flex gap-2">
            <a class="btn btn-sm btn-outline-secondary" asp-controller="Lessons" asp-action="Edit" asp-route-id="@l.Id">Edit</a>
            <form asp-controller="Lessons" asp-action="Delete" asp-route-id="@l.Id" method="post" onsubmit="return confirm('Delete this lesson?');">
                <button class="btn btn-sm btn-outline-danger">Delete</button>
            </form>
        </span>
                }
    </li>
        }
</ul>
}