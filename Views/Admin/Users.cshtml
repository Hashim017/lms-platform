@model List<UserRow>
    @{
    ViewData["Title"] = "Users";
    var me = ViewBag.Me as string;
    }

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 page-head reveal">
        <div>
            <h1>Manage <span class="grad-text">users</span></h1>
            <p class="text-muted mb-0">Change who can teach or manage the platform.</p>
        </div>
        <a class="btn btn-ghost" asp-action="Index"><i class="bi bi-arrow-left"></i> Dashboard</a>
    </div>

    <form method="get" class="glass filter-bar reveal">
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input name="q" value="@ViewBag.Q" class="form-control" placeholder="Search by name or email" autocomplete="off" />
        </div>
        <button class="btn btn-primary">Search</button>
    </form>

    @if (!Model.Any())
{
    <div class="glass empty"><i class="bi bi-emoji-frown"></i><h5 class="mt-3">No users found</h5></div>
}
else
{
    <div class="glass p-2 reveal" style="overflow-x:auto">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Joined</th>
                    <th>Courses</th>
                    <th>Role</th>
                    <th>Change role</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                <tr>
                    <td class="fw-semibold">@(string.IsNullOrWhiteSpace(u.FullName) ? "-" : u.FullName)</td>
                    <td>@u.Email</td>
                    <td>@u.CreatedAt.ToString("dd MMM yyyy")</td>
                    <td>@u.Enrolled</td>
                    <td><span class="role-badge role-@u.Role">@u.Role</span></td>
                    <td>
                        @if (u.Id == me)
                            {
                        <span class="small text-muted">This is you</span>
                            }
                            else
                            {
                        <form asp-action="SetRole" method="post" class="d-flex gap-2">
                            <input type="hidden" name="id" value="@u.Id" />
                            <select name="role" class="form-select form-select-sm" style="min-width:130px">
                                @foreach (var r in new[] { "Student", "Instructor", "Admin" })
                                        {
                                <option value="@r" selected="@(u.Role == r)">@r</option>
                                        }
                            </select>
                            <button class="btn btn-sm btn-outline-primary">Save</button>
                        </form>
                            }
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
}
