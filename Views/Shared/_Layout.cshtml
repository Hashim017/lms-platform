@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isStaff = User.IsInRole("Admin") || User.IsInRole("Instructor");
    var navHome = ctrl == "Home";
    var navCourses = ctrl == "Courses" && action != "Manage";
    var navLearn = ctrl == "Enrollments" || ctrl == "Learn";
    var navManage = ctrl == "Courses" && action == "Manage";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lumen</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        try {
            var t = localStorage.getItem('lms-theme');
            if (t) document.documentElement.setAttribute('data-bs-theme', t);
        } catch (e) { }
    </script>
</head>
<body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
        <defs>
            <linearGradient id="ringGrad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#7c6cff" />
                <stop offset="1" stop-color="#22d3ee" />
            </linearGradient>
        </defs>
    </svg>

    <nav class="navbar navbar-expand-lg nav-glass">
        <div class="container">
            <a class="navbar-brand brand" asp-controller="Home" asp-action="Index">
                <span class="logo-mark"><i class="bi bi-lightning-charge-fill"></i></span>Lumen
            </a>
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Menu">
                <i class="bi bi-list fs-2" style="color:var(--text)"></i>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto gap-lg-1 mt-3 mt-lg-0">
                    <li class="nav-item"><a class="nav-link @(navHome ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link @(navCourses ? "active" : "")" asp-controller="Courses" asp-action="Index">Courses</a></li>
                    @if (signedIn && !isStaff)
                    {
                    <li class="nav-item"><a class="nav-link @(navLearn ? "active" : "")" asp-controller="Enrollments" asp-action="MyLearning">My learning</a></li>
                    }
                    @if (isStaff)
                    {
                    <li class="nav-item"><a class="nav-link @(navManage ? "active" : "")" asp-controller="Courses" asp-action="Manage">Manage courses</a></li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                    <li class="nav-item"><a class="nav-link @(ctrl == "Admin" ? "active" : "")" asp-controller="Admin" asp-action="Index">Admin</a></li>
                    }
                </ul>
                <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                    <button id="themeToggle" type="button" class="btn-icon" aria-label="Toggle theme"></button>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </div>
    </nav>

    <div class="toast-stack">
        @if (TempData["Success"] is string okMsg)
        {
        <div class="toast-lms ok"><i class="bi bi-check-circle-fill"></i><span>@okMsg</span></div>
        }
        @if (TempData["Error"] is string errMsg)
        {
        <div class="toast-lms err"><i class="bi bi-exclamation-circle-fill"></i><span>@errMsg</span></div>
        }
    </div>

    <main class="container py-4" role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; @DateTime.Now.Year Lumen Learning Platform</span>
            <span>Built with ASP.NET Core and PostgreSQL</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>