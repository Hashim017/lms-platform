@if (User.Identity?.IsAuthenticated == true)
{
    var name = User.Identity?.Name ?? "?";
    var isAdmin = User.IsInRole("Admin");
    var isInstructor = User.IsInRole("Instructor");
<div class="dropdown">
    <button class="avatar" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu">
        @name.Substring(0, 1).ToUpper()
    </button>
    <ul class="dropdown-menu dropdown-menu-end">
        <li class="px-3 py-2 small text-muted">@name</li>
        <li><hr class="dropdown-divider" /></li>
        @if (isAdmin)
            {
        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Admin dashboard</a></li>
            }
        @if (isAdmin || isInstructor)
            {
        <li><a class="dropdown-item" asp-controller="Courses" asp-action="Manage"><i class="bi bi-journal-richtext me-2"></i>Manage courses</a></li>
            }
            else
            {
        <li><a class="dropdown-item" asp-controller="Enrollments" asp-action="MyLearning"><i class="bi bi-journal-bookmark me-2"></i>My learning</a></li>
            }
        <li><a class="dropdown-item" asp-controller="Account" asp-action="Settings"><i class="bi bi-person-gear me-2"></i>Account settings</a></li>
        <li>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
            </form>
        </li>
    </ul>
</div>
}
else
{
<a class="btn btn-ghost btn-sm" asp-controller="Account" asp-action="Login">Login</a>
<a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Sign up</a>
}