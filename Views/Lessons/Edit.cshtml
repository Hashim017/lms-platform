@model LessonFormViewModel
@{
    ViewData["Title"] = "Edit lesson";
}

<h1>Edit lesson</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CourseId" />
    <partial name="_LessonForm" model="Model" />
    <button class="btn btn-primary">Save</button>
    <a class="btn btn-secondary" asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}