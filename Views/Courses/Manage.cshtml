@model List<Course>
    @{
    ViewData["Title"] = "Manage courses";
    }

    <div class="d-flex justify-content-between align-items-center page-head reveal">
        <div>
            <h1>Manage <span class="grad-text">courses</span></h1>
            <p class="text-muted mb-0">Create, edit and publish your courses.</p>
        </div>
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> New course</a>
    </div>

    @if (!Model.Any())
{
    <div class="glass empty">
        <i class="bi bi-journal-plus"></i>
        <h5 class="mt-3">No courses yet</h5>
        <p class="text-muted">Create your first course to get started.</p>
    </div>
}
else
{
    <div class="glass p-2 reveal" style="overflow-x:auto">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Lessons</th>
                    <th>Learners</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                <tr>
                    <td class="fw-semibold">@c.Title</td>
                    <td>@c.Category</td>
                    <td>@c.Lessons.Count</td>
                    <td>@c.Enrollments.Count</td>
                    <td>
                        @if (c.IsPublished)
                            {
                        <span class="badge bg-success">Published</span>
                            }
                            else
                            {
                        <span class="badge bg-warning text-dark">Draft</span>
                            }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@c.Id">Open</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@c.Id">Edit</a>
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
}
