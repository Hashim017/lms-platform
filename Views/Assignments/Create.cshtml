@model AssignmentFormViewModel
@{
    ViewData["Title"] = "New assignment";
}

<div class="glass form-card reveal">
    <h2 class="mb-4">New <span class="grad-text">assignment</span></h2>
    <form asp-action="Create" method="post">
        <input type="hidden" asp-for="CourseId" />
        <partial name="_AssignmentForm" model="Model" />
        <button class="btn btn-primary">Save assignment</button>
        <a class="btn btn-ghost" asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}