@model LoginViewModel
@{
    ViewData["Title"] = "Log in";
    ViewData["SideTitle"] = "Welcome back";
    ViewData["SideText"] = "Pick up exactly where you stopped.";
    var showDemo = (bool)(ViewBag.ShowDemo ?? false);
}

<div class="auth-wrap reveal">
    <partial name="_AuthSide" />

    <div class="auth-card">
        <h2>Log in</h2>
        <p class="text-muted">Enter your details to continue.</p>

        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <div class="field">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <div class="field">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Password" class="form-control" placeholder="Your password" autocomplete="current-password" />
                    <button type="button" class="eye" data-eye aria-label="Show password"><i class="bi bi-eye"></i></button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <button class="btn btn-primary btn-lg w-100">Log in <i class="bi bi-arrow-right"></i></button>
        </form>

        <p class="text-muted mt-4 mb-0">New here? <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a></p>

        @if (showDemo)
        {
        <div class="demo-box">
            <div class="small text-muted">Try a demo account. Click one to fill the form.</div>
            <div class="demo-chips">
                <button type="button" class="chip" data-demo data-email="student@lms.com" data-pass="Student@123"><i class="bi bi-mortarboard"></i> Student</button>
                <button type="button" class="chip" data-demo data-email="instructor@lms.com" data-pass="Instructor@123"><i class="bi bi-person-video3"></i> Instructor</button>
                <button type="button" class="chip" data-demo data-email="admin@lms.com" data-pass="Admin@123"><i class="bi bi-shield-lock"></i> Admin</button>
            </div>
        </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}