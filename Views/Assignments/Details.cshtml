@model AssignmentPageViewModel
@{
    var a = Model.Assignment;
    ViewData["Title"] = a.Title;
    var due = DateTime.SpecifyKind(a.DueDate, DateTimeKind.Utc);
    var mine = Model.Mine;
}

<div class="detail-hero grad-@(Model.Course.Id % 6) reveal">
    <i class="bi bi-journal-text big-icon"></i>
    <span class="pill" style="background:rgba(0,0,0,.25);color:#fff;border-color:transparent">Assignment</span>
    <h1 class="mt-3">@a.Title</h1>
    <p class="mb-0 opacity-75">@Model.Course.Title | Max score @a.MaxScore</p>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="glass p-4 mb-4 reveal">
            <h4>Instructions</h4>
            <p class="text-muted mb-0" style="white-space:pre-wrap">@a.Instructions</p>
        </div>

        @if (!Model.CanManage && Model.IsEnrolled)
        {
        <div class="glass p-4 mb-4 reveal">
            <h4>Your submission</h4>

            @if (mine != null && mine.Score != null)
                {
                    var pct = mine.Score.Value * 100 / a.MaxScore;
            <div class="d-flex align-items-center gap-3 my-3">
                <div style="--size:96px"><partial name="_Ring" model="pct" /></div>
                <div>
                    <div class="fw-bold fs-4">@mine.Score / @a.MaxScore</div>
                    <div class="text-muted small">Graded</div>
                </div>
            </div>
            <div class="sub-text">@mine.Content</div>
            @if (!string.IsNullOrWhiteSpace(mine.Feedback))
                    {
            <div class="feedback-box"><strong>Feedback</strong><br />@mine.Feedback</div>
                    }
                }
                else
                {
                    if (mine != null)
                    {
            <p class="small text-muted">
                Submitted on @mine.SubmittedAt.ToString("dd MMM yyyy, HH:mm") UTC.
                @if (mine.SubmittedAt > a.DueDate)
                            {
                <span class="late-text">Late</span>
                            }
                You can send a new version until it is graded.
            </p>
                    }
            <form asp-action="Submit" asp-route-id="@a.Id" method="post">
                <textarea class="form-control mb-3" name="content" rows="8" maxlength="5000" required placeholder="Write your answer here">@mine?.Content</textarea>
                <button class="btn btn-primary"><i class="bi bi-send"></i> @(mine == null ? "Submit work" : "Update submission")</button>
            </form>
                }
        </div>
        }

        @if (Model.CanManage)
        {
        <h4 class="mb-3">Submissions</h4>

        @if (!Model.All.Any())
            {
        <div class="glass p-4 text-muted">No submissions yet.</div>
            }

        @foreach (var s in Model.All)
            {
        <div class="glass sub-card reveal">
            <div class="d-flex justify-content-between flex-wrap gap-2">
                <strong>@(s.Student?.FullName ?? "Student")</strong>
                <span class="small text-muted">
                    @s.SubmittedAt.ToString("dd MMM yyyy, HH:mm") UTC
                    @if (s.SubmittedAt > a.DueDate)
                            {
                    <span class="late-text">Late</span>
                            }
                </span>
            </div>
            <div class="sub-text">@s.Content</div>
            <form asp-action="Grade" asp-route-id="@s.Id" method="post">
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small">Score out of @a.MaxScore</label>
                        <input class="form-control" type="number" name="score" min="0" max="@a.MaxScore" value="@s.Score" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small">Feedback</label>
                        <input class="form-control" name="feedback" value="@s.Feedback" maxlength="1000" />
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-primary w-100">@(s.Score == null ? "Save grade" : "Update grade")</button>
                    </div>
                </div>
            </form>
        </div>
            }
        }
    </div>

    <div class="col-lg-4">
        <div class="glass side-card reveal">
            <span id="countdown" class="pill" data-due="@due.ToString("o")"></span>
            <div class="mt-3">
                <div class="fact"><span class="text-muted">Due</span><strong id="dueLocal"></strong></div>
                <div class="fact"><span class="text-muted">Max score</span><strong>@a.MaxScore</strong></div>
                @if (Model.CanManage)
                {
                <div class="fact"><span class="text-muted">Submissions</span><strong>@Model.All.Count</strong></div>
                }
            </div>
            <hr />
            <a class="btn btn-ghost btn-sm w-100 mb-2" asp-controller="Courses" asp-action="Details" asp-route-id="@Model.Course.Id"><i class="bi bi-arrow-left"></i> Back to course</a>
            @if (Model.CanManage)
            {
            <a class="btn btn-outline-secondary btn-sm w-100 mb-2" asp-action="Edit" asp-route-id="@a.Id"><i class="bi bi-pencil"></i> Edit assignment</a>
            <form asp-action="Delete" asp-route-id="@a.Id" method="post" onsubmit="return confirm('Delete this assignment and all submissions?');">
                <button class="btn btn-outline-danger btn-sm w-100"><i class="bi bi-trash"></i> Delete assignment</button>
            </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var el = document.getElementById('countdown');
            var due = new Date(el.dataset.due);
            document.getElementById('dueLocal').textContent = due.toLocaleString();

            function tick() {
                var ms = due - new Date();
                if (ms <= 0) {
                    el.textContent = 'Past due';
                    el.classList.add('late-text');
                    return;
                }
                var d = Math.floor(ms / 864e5);
                var h = Math.floor(ms % 864e5 / 36e5);
                var m = Math.floor(ms % 36e5 / 6e4);
                el.innerHTML = '<i class="bi bi-hourglass-split"></i> ' + d + 'd ' + h + 'h ' + m + 'm left';
            }
            tick();
            setInterval(tick, 30000);
        })();
    </script>
}