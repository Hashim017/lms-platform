@model QuizEditViewModel
@{
    ViewData["Title"] = "Edit quiz";
    var questions = Model.Quiz.Questions.OrderBy(q => q.Id).ToList();
}

<div class="page-head reveal d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <a class="small" asp-controller="Courses" asp-action="Details" asp-route-id="@Model.Course.Id"><i class="bi bi-arrow-left"></i> @Model.Course.Title</a>
        <h1>Edit <span class="grad-text">quiz</span></h1>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-ghost" asp-action="Take" asp-route-id="@Model.Quiz.Id"><i class="bi bi-eye"></i> Preview</a>
        <form asp-action="Delete" asp-route-id="@Model.Quiz.Id" method="post" onsubmit="return confirm('Delete this quiz and all its attempts?');">
            <button class="btn btn-outline-danger"><i class="bi bi-trash"></i> Delete quiz</button>
        </form>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="glass p-4 mb-4 reveal">
            <h5 class="mb-3">Quiz settings</h5>
            <form asp-action="Update" method="post">
                <input type="hidden" name="Id" value="@Model.Quiz.Id" />
                <input type="hidden" name="CourseId" value="@Model.Quiz.CourseId" />
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label">Title</label>
                        <input class="form-control" name="Title" value="@Model.Quiz.Title" required maxlength="120" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Pass mark in percent</label>
                        <input class="form-control" type="number" name="PassMark" value="@Model.Quiz.PassMark" min="1" max="100" required />
                    </div>
                </div>
                <button class="btn btn-primary btn-sm mt-3">Save settings</button>
            </form>
        </div>

        <h5 class="mb-3">Questions</h5>

        @if (!questions.Any())
        {
        <div class="glass p-4 text-muted mb-4">No questions yet. Add the first one below.</div>
        }

        @for (var i = 0; i < questions.Count; i++)
        {
            var q = questions[i];
        <div class="glass q-card reveal">
            <div class="d-flex justify-content-between align-items-start gap-2">
                <div>
                    <div class="small text-muted">Question @(i + 1)</div>
                    <h6 class="mb-2">@q.Text</h6>
                </div>
                <form asp-action="DeleteQuestion" asp-route-id="@q.Id" method="post" onsubmit="return confirm('Delete this question?');">
                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                </form>
            </div>
            @foreach (var o in q.Options.OrderBy(x => x.Id))
                {
            <div class="opt-line">
                <i class="bi @(o.IsCorrect ? "bi-check-circle-fill" : "bi-circle")"></i>
                <span>@o.Text</span>
            </div>
                }
        </div>
        }

        <div class="glass p-4 mt-4 reveal">
            <h5 class="mb-3">Add a question</h5>
            <form asp-action="AddQuestion" method="post">
                <input type="hidden" name="QuizId" value="@Model.Quiz.Id" />
                <div class="mb-3">
                    <label class="form-label">Question</label>
                    <textarea class="form-control" name="Text" rows="2" required maxlength="500"></textarea>
                </div>
                <label class="form-label">Options. Select the radio button of the correct one.</label>
                @for (var n = 1; n <= 4; n++)
                {
                <div class="input-group mb-2">
                    <div class="input-group-text">
                        <input class="form-check-input mt-0" type="radio" name="CorrectIndex" value="@n" checked="@(n == 1)" />
                    </div>
                    <input class="form-control" name="@("Option" + n)" placeholder="@("Option " + n)" maxlength="200" required="@(n <= 2)" />
                </div>
                }
                <button class="btn btn-primary mt-2"><i class="bi bi-plus-lg"></i> Add question</button>
            </form>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="glass side-card reveal">
            <h5>Recent attempts</h5>
            @if (!Model.Attempts.Any())
            {
            <p class="text-muted small mb-0">No one has taken this quiz yet.</p>
            }
            @foreach (var a in Model.Attempts)
            {
                var pct = a.Total == 0 ? 0 : a.Score * 100 / a.Total;
            <div class="attempt-row">
                <span>@(a.Student?.FullName ?? "Student")<br /><span class="small text-muted">@a.TakenAt.ToString("dd MMM, HH:mm")</span></span>
                <strong>@a.Score / @a.Total | @pct%</strong>
            </div>
            }
        </div>
    </div>
</div>