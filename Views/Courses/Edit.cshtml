@model CourseFormViewModel
@{
    ViewData["Title"] = "Edit course";
}

<div class="glass form-card reveal">
    <h2 class="mb-4">Edit <span class="grad-text">course</span></h2>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <partial name="_CourseForm" model="Model" />
        <button class="btn btn-primary">Save changes</button>
        <a class="btn btn-ghost" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}