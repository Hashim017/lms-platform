@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin";
    var max = Math.Max(1, Model.PerDay.Max(d => d.Count));
    var topMax = Math.Max(1, Model.Top.Any() ? Model.Top.Max(t => t.Learners) : 1);
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 page-head reveal">
    <div>
        <h1>Admin <span class="grad-text">dashboard</span></h1>
        <p class="text-muted mb-0">A quick look at the whole platform.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-action="Users"><i class="bi bi-people"></i> Manage users</a>
        <a class="btn btn-ghost" asp-controller="Courses" asp-action="Manage"><i class="bi bi-journal-richtext"></i> All courses</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3 reveal"><div class="glass stat"><i class="bi bi-people"></i><div class="num" data-count="@Model.Users">0</div><div class="text-muted small">Users</div></div></div>
    <div class="col-6 col-lg-3 reveal" style="--d:.06s"><div class="glass stat"><i class="bi bi-journal-richtext"></i><div class="num" data-count="@Model.Courses">0</div><div class="text-muted small">Courses, @Model.Published published</div></div></div>
    <div class="col-6 col-lg-3 reveal" style="--d:.12s"><div class="glass stat"><i class="bi bi-person-check"></i><div class="num" data-count="@Model.Enrollments">0</div><div class="text-muted small">Enrollments</div></div></div>
    <div class="col-6 col-lg-3 reveal" style="--d:.18s"><div class="glass stat"><i class="bi bi-trophy"></i><div class="num"><span data-count="@Model.CompletionRate">0</span>%</div><div class="text-muted small">Completion rate</div></div></div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3 reveal"><div class="glass stat"><i class="bi bi-mortarboard"></i><div class="num" data-count="@Model.Students">0</div><div class="text-muted small">Students</div></div></div>
    <div class="col-6 col-lg-3 reveal" style="--d:.06s"><div class="glass stat"><i class="bi bi-person-video3"></i><div class="num" data-count="@Model.Instructors">0</div><div class="text-muted small">Instructors</div></div></div>
    <div class="col-6 col-lg-3 reveal" style="--d:.12s"><div class="glass stat"><i class="bi bi-patch-question"></i><div class="num" data-count="@Model.QuizAttempts">0</div><div class="text-muted small">Quiz attempts</div></div></div>
    <div class="col-6 col-lg-3 reveal" style="--d:.18s"><div class="glass stat"><i class="bi bi-journal-text"></i><div class="num" data-count="@Model.Submissions">0</div><div class="text-muted small">Submissions</div></div></div>
</div>

<div class="row g-4">
    <div class="col-lg-7 reveal">
        <div class="glass p-4 h-100">
            <h5 class="mb-4">Enrollments in the last 7 days</h5>
            <div class="bars">
                @foreach (var d in Model.PerDay)
                {
                    var h = d.Count * 100 / max;
                    <div class="bar-col">
                        <div class="bar-val">@d.Count</div>
                        <div class="bar" style="--h:@(h)%"></div>
                        <div class="bar-label">@d.Label</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5 reveal" style="--d:.1s">
        <div class="glass p-4 h-100">
            <h5 class="mb-3">Top courses</h5>
            @if (!Model.Top.Any())
            {
                <p class="text-muted mb-0">No courses yet.</p>
            }
            @foreach (var t in Model.Top)
            {
                var w = t.Learners * 100 / topMax;
                <div class="mb-3">
                    <div class="d-flex justify-content-between">
                        <strong>@t.Title</strong>
                        <span class="small text-muted">@t.Learners learners</span>
                    </div>
                    <div class="small text-muted">@t.Instructor</div>
                    <div class="hbar"><span style="--w:@(w)%"></span></div>
                </div>
            }
        </div>
    </div>
</div>